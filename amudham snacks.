<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>அமுதம் ஸ்நாக்ஸ் | Amudham Snacks</title>

<meta name="description" content="அமுதம் ஸ்நாக்ஸ் - Banana Chips, Halwa, Kadalai, Peanut Candy and Macroon. Order traditional snacks through WhatsApp.">

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fffaf2;
  color: #333;
}

header {
  background: #8b4513;
  color: white;
  padding: 25px 15px;
  text-align: center;
}

header h1 {
  margin: 0;
  font-size: 32px;
}

header p {
  margin: 8px 0 0;
  font-size: 17px;
}

.container {
  max-width: 1100px;
  margin: auto;
  padding: 30px 15px;
}

.search-box {
  display: flex;
  gap: 10px;
  max-width: 600px;
  margin: 0 auto 30px;
}

.search-box input {
  flex: 1;
  padding: 14px;
  border: 2px solid #d6a15c;
  border-radius: 10px;
  font-size: 16px;
  outline: none;
}

.search-box button {
  padding: 14px 18px;
  border: none;
  border-radius: 10px;
  background: #8b4513;
  color: white;
  cursor: pointer;
}

.search-box button:hover {
  background: #6f350e;
}

.status {
  text-align: center;
  margin-bottom: 20px;
  color: #777;
}

.products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.snack-card {
  background: white;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.12);
  transition: transform 0.2s;
}

.snack-card:hover {
  transform: translateY(-5px);
}

.snack-img {
  height: 210px;
  background: #f4dfc1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70px;
  overflow: hidden;
}

.snack-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.snack-body {
  padding: 20px;
}

.snack-body h3 {
  margin-top: 0;
  color: #8b4513;
  font-size: 22px;
}

.snack-body p {
  line-height: 1.5;
}

.snack-price {
  font-weight: bold;
  font-size: 18px;
  color: #d2691e;
}

.btn-wa {
  display: inline-block;
  margin-top: 10px;
  padding: 11px 15px;
  background: #25D366;
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: bold;
}

.btn-wa:hover {
  background: #1da851;
}

.no-results {
  text-align: center;
  padding: 40px;
  font-size: 20px;
}

footer {
  margin-top: 50px;
  background: #8b4513;
  color: white;
  text-align: center;
  padding: 20px;
}

@media (max-width: 800px) {
  .products {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 550px) {
  header h1 {
    font-size: 25px;
  }

  .products {
    grid-template-columns: 1fr;
  }

  .search-box {
    flex-direction: column;
  }
}
</style>

</head>

<body>

<header>
  <h1>அமுதம் ஸ்நாக்ஸ்</h1>
  <p>Amudham Snacks</p>
  <p>Traditional & Tasty Snacks</p>
</header>

<main class="container">

  <h2 style="text-align:center;">Our Snacks</h2>

  <div class="search-box">
    <input
      type="text"
      id="snackSearch"
      placeholder="🔍 Search snacks..."
      autocomplete="off"
    >
    <button id="snackClearBtn">Clear</button>
  </div>

  <div class="status" id="snackStatus"></div>

  <div class="products" id="snackGrid"></div>

  <div class="no-results" id="snackNoResults" hidden>
    No snacks found 😔
  </div>

</main>

<footer>
  <p>அமுதம் ஸ்நாக்ஸ் | Amudham Snacks</p>
  <p>📞 9942608020</p>
  <p>© <span id="year"></span> Amudham Snacks</p>
</footer>

<script>

(function () {

  "use strict";

  var WHATSAPP_NUMBER = "919942608020";

  function whatsappLink(message) {
    return "https://wa.me/" + WHATSAPP_NUMBER +
      "?text=" + encodeURIComponent(message);
  }

  var products = [

    {
      name: "Banana Chips",
      emoji: "🍌",
      image: "images/banana-chips.jpg",
      desc: "Crispy, golden banana chips fried fresh.",
      price: "₹XX",
      keywords: ["banana", "chips"]
    },

    {
      name: "Halwa",
      emoji: "🍮",
      image: "images/halwa.jpg",
      desc: "Soft, sweet halwa in the traditional style.",
      price: "₹XX",
      keywords: ["halwa"]
    },

    {
      name: "Kadalai",
      emoji: "🥜",
      image: "images/kadalai.jpg",
      desc: "Crunchy, tasty kadalai snack.",
      price: "₹XX",
      keywords: ["kadalai", "groundnut", "peanut"]
    },

    {
      name: "Peanut Candy",
      emoji: "🍬",
      image: "images/peanut-candy.jpg",
      desc: "Crunchy peanut candy with a sweet bite.",
      price: "₹XX",
      keywords: ["peanut", "candy"]
    },

    {
      name: "Macroon",
      emoji: "🍪",
      image: "images/macroon.jpg",
      desc: "Sweet, chewy macroon treats.",
      price: "₹XX",
      keywords: ["macroon", "macaroon"]
    }

  ];

  var grid = document.getElementById("snackGrid");
  var input = document.getElementById("snackSearch");
  var noResults = document.getElementById("snackNoResults");
  var clearBtn = document.getElementById("snackClearBtn");
  var status = document.getElementById("snackStatus");

  function normalize(text) {

    return String(text)
      .toLowerCase()
      .replace(/\s+/g, " ")
      .trim();

  }

  function createCard(product) {

    var card = document.createElement("div");

    card.className = "snack-card";

    var imageBox = document.createElement("div");

    imageBox.className = "snack-img";

    imageBox.textContent = product.emoji;

    var img = document.createElement("img");

    img.src = product.image;

    img.alt = product.name + " - Amudham Snacks";

    img.loading = "lazy";

    img.onerror = function () {
      img.style.display = "none";
    };

    imageBox.appendChild(img);

    var body = document.createElement("div");

    body.className = "snack-body";

    var title = document.createElement("h3");

    title.textContent = product.name;

    var description = document.createElement("p");

    description.textContent = product.desc;

    var price = document.createElement("p");

    price.className = "snack-price";

    price.textContent = product.price;

    var orderButton = document.createElement("a");

    orderButton.className = "btn-wa";

    orderButton.href = whatsappLink(
      "Hello Amudham Snacks, I would like to order " +
      product.name + "."
    );

    orderButton.target = "_blank";

    orderButton.rel = "noopener noreferrer";

    orderButton.textContent = "Order on WhatsApp";

    body.appendChild(title);
    body.appendChild(description);
    body.appendChild(price);
    body.appendChild(orderButton);

    card.appendChild(imageBox);
    card.appendChild(body);

    return card;

  }

  function render(list) {

    grid.innerHTML = "";

    list.forEach(function(product) {

      grid.appendChild(createCard(product));

    });

    if (list.length === 0) {

      grid.hidden = true;

      noResults.hidden = false;

      status.textContent = "0 snacks found";

    } else {

      grid.hidden = false;

      noResults.hidden = true;

      status.textContent =
        list.length +
        (list.length === 1 ? " snack found" : " snacks found");

    }

  }

  function searchProducts() {

    var query = normalize(input.value);

    if (query === "") {

      render(products);

      return;

    }

    var words = query.split(" ");

    var filtered = products.filter(function(product) {

      var searchableText = normalize(
        product.name + " " +
        product.keywords.join(" ")
      );

      return words.every(function(word) {

        return searchableText.indexOf(word) !== -1;

      });

    });

    render(filtered);

  }

  function clearSearch() {

    input.value = "";

    render(products);

    input.focus();

  }

  input.addEventListener("input", searchProducts);

  input.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {

      clearSearch();

    }

  });

  clearBtn.addEventListener("click", clearSearch);

  document.getElementById("year").textContent =
    new Date().getFullYear();

  render(products);

})();

</script>

</body>
</html>
