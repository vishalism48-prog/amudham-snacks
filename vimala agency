    margin-bottom:35px;
}

.section-title h2{
    font-size:35px;
    color:#7b2d16;
}

.section-title p{
    color:#777;
    margin-top:8px;
}

/* SEARCH */
.search-box{
    max-width:650px;
    margin:0 auto 35px;
    position:relative;
}

.search-box input{
    width:100%;
    padding:17px 22px;
    border:2px solid #e6c9a8;
    border-radius:35px;
    font-size:16px;
    outline:none;
}

.search-box input:focus{
    border-color:#b94e20;
}

/* PRODUCTS */
.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:25px;
}

.product{
    background:white;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 7px 20px rgba(0,0,0,0.1);
    transition:0.3s;
}

.product:hover{
    transform:translateY(-7px);
}

.product-img{
    height:190px;
    background:linear-gradient(135deg,#ffe0a3,#fff1cf);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:75px;
}

.product-content{
    padding:20px;
}

.product-content h3{
    color:#7b2d16;
    margin-bottom:8px;
}

.product-content p{
    color:#777;
    font-size:14px;
    min-height:40px;
}

.price{
    color:#b94e20;
    font-size:21px;
    font-weight:bold;
    margin:15px 0;
}

.order-btn{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    background:#7b2d16;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.order-btn:hover{
    background:#b94e20;
}

/* ABOUT */
.about{
    background:#fff0d6;
}

.about-box{
    max-width:900px;
    margin:auto;
    text-align:center;
    line-height:1.8;
}

/* CONTACT */
.contact{
    text-align:center;
}

.contact-card{
    max-width:600px;
    margin:auto;
    background:white;
    padding:35px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,0.1);
}

.phone{
    display:inline-block;
    margin:20px 0;
    font-size:25px;
    font-weight:bold;
    color:#7b2d16;
}

/* FOOTER */
footer{
    background:#4a1c0d;
    color:white;
    text-align:center;
    padding:25px;
}

/* MOBILE */
@media(max-width:900px){

    .hero{
        flex-direction:column;
        text-align:center;
        padding:60px 5%;
    }

    .hero-text h1{
        font-size:42px;
    }

    .dashboard{
        grid-template-columns:repeat(2,1fr);
    }

    .products{
        grid-template-columns:repeat(2,1fr);
    }

    nav ul{
        display:none;
    }
}

@media(max-width:600px){

    .dashboard{
        grid-template-columns:1fr 1fr;
    }

    .products{
        grid-template-columns:1fr;
    }

    .hero-text h1{
        font-size:38px;
    }

    .hero-text h2{
        font-size:22px;
    }
}
</style>
</head>

